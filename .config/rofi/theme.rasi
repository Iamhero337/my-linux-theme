* {
    font: "JetBrains Mono 12";
    bg-col:  #14171a;
    bg-col-light: #1e2329;
    border-col: #84d2e6;
    selected-col: #1e2329;
    blue: #84d2e6;
    fg-col: #e1e3e8;
    fg-col2: #9da5b4;
    grey: #5c6370;
    width: 600;
    highlight: bold italic;
    transparent: rgba(0,0,0,0);
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 380px;
    border: 2px;
    border-radius: 8px;
    border-color: @border-col;
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 6px;
    padding: 2px;
}

prompt {
    background-color: @blue;
    padding: 6px;
    text-color: @bg-col;
    border-radius: 4px;
    margin: 10px 0px 0px 10px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    margin: 10px 10px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col-light;
    border-radius: 4px;
    placeholder: "Search...";
    placeholder-color: @grey;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 10px 10px 10px;
    margin: 10px 0px 0px 0px;
    columns: 1;
    lines: 6;
    background-color: @bg-col;
}

element {
    padding: 6px 10px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 4px;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}

element selected {
    background-color:  @selected-col;
    text-color: @blue;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 8px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @blue;
}

message {
    background-color: @bg-col-light;
    margin: 2px;
    padding: 2px;
    border-radius: 5px;
}

textbox {
    padding: 6px;
    margin: 10px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col-light;
}
